# ---- API (api/) ----
# LLM_PROVIDER: none | ollama | openai   (none = rules only, always works offline)
LLM_PROVIDER=none
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_URL=http://localhost:11434
# Only for LLM_PROVIDER=openai; provider data handling and usage terms apply.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
OFFER_TTL_S=45
WAVE_SIZE=2
ALLOWED_ORIGINS=http://localhost:3000
# Keep 0 on a public deployment. Set 1 only for a local, fictional-data demonstration.
DEMO_MODE=0
# Required when DEMO_MODE=0: generate with python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Staff enter this key in the operator sign-in form. Never put it in NEXT_PUBLIC_*.
ISHARA_OPERATOR_KEY=
# Secure cookies require HTTPS. Set 0 only when testing operator sign-in over local HTTP.
OPERATOR_COOKIE_SECURE=1

# Telegram bot token from @BotFather (free). Leave blank to disable.
TELEGRAM_BOT_TOKEN=
ISHARA_DB=data/ishara.db
# One-tap handoff when no local interpreter is available. Provider sign-in may be required.
REMOTE_INTERPRETER_URL=https://sanadrelay.cda.gov.ae/
# A reviewed, licensed Emirati Sign Language recording of the script in README.md.
# Place a clip at web/public/sign/confirmed.mp4 and set /sign/confirmed.mp4, or use an HTTPS video URL.
CONFIRMATION_VIDEO_URL=

# ---- Web (web/.env.local) ----
# The Next.js server proxies /api to this origin. No /api suffix or trailing slash.
# Local development defaults to http://127.0.0.1:8000; set the deployed HTTPS API origin on Vercel.
# ISHARA_API_URL=https://your-api.example.com
# NEXT_PUBLIC_API_URL is a legacy direct-browser override; leave unset for same-origin operator cookies.
